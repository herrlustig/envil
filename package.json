{
  "name": "envil",
  "displayName": "ENVIL",
  "description": "A/V live-coding environment using Hydra and SuperCollider",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inspektral/envil"
  },
  "publisher": "killbizz",
  "license": "GPL-3.0",
  "contributors": [
    {
      "name": "Tito Scutari",
      "email": "tito.scutari@gmail.com",
      "url": "https://github.com/inspektral"
    },
    {
      "name": "Gabriel Bizzo",
      "email": "gabriel.bizzo@hotmail.it",
      "url": "https://github.com/killbizz"
    },
    {
      "name": "Roger Vila",
      "url": "https://github.com/rogervila"
    }
  ],
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "live-coding",
    "live coding",
    "hydra",
    "supercollider",
    "audiovisual",
    "scd"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "extension.js",
  "icon": "resources/logo.png",
  "contributes": {
    "languages": [
      {
        "id": "supercollider",
        "aliases": [
          "SuperCollider",
          "supercollider",
          "scd",
          "sc"
        ],
        "extensions": [
          ".sc",
          ".scd",
          ".schelp"
        ],
        "configuration": "./supercollider/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "supercollider",
        "scopeName": "source.supercollider",
        "path": "./supercollider/syntaxes/supercollider.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "supercollider",
        "path": "./supercollider/snippets/supercollider.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "envil.start",
        "title": "Envil: Open Environment"
      },
      {
        "command": "envil.stop",
        "title": "Envil: Close Environment"
      },
      {
        "command": "envil.hydra.evaluate",
        "title": "Envil: Evaluate \u2013 Hydra"
      },
      {
        "command": "envil.supercollider.executeBlock",
        "title": "Envil: Execute Block \u2013 SuperCollider"
      },
      {
        "command": "envil.supercollider.startSCLang",
        "title": "Envil: Start SCLang"
      },
      {
        "command": "envil.supercollider.stopSCLang",
        "title": "Envil: Stop SCLang"
      },
      {
        "command": "envil.supercollider.toggleSCLang",
        "title": "Envil: Toggle SCLang"
      },
      {
        "command": "envil.supercollider.startSCSynth",
        "title": "Envil: Boot SCSynth"
      },
      {
        "command": "envil.supercollider.stopSCSynth",
        "title": "Envil: Stop SCSynth"
      },
      {
        "command": "envil.supercollider.toggleSCSynth",
        "title": "Envil: Toggle SCSynth"
      },
      {
        "command": "envil.supercollider.rebootServer",
        "title": "Envil: Reboot Server \u2013 SuperCollider"
      },
      {
        "command": "envil.supercollider.hush",
        "title": "Envil: Hush / Stop All Sounds"
      },
      {
        "command": "envil.supercollider.reloadSynthDefs",
        "title": "Envil: Reload Default SynthDefs – SuperCollider"
      },
      {
        "command": "envil.supercollider.openHelpFor",
        "title": "Envil: Open Help for Word Under Cursor"
      },
      {
        "command": "envil.supercollider.search",
        "title": "Envil: Search \u2013 SuperCollider"
      },
      {
        "command": "envil.supercollider.selectBracketBlock",
        "title": "Envil: Select Bracket Block \u2013 SuperCollider"
      },
      {
        "command": "envil.numberAdjust",
        "title": "Envil: Adjust Number (hover slider)"
      },
      {
        "command": "envil.numberNudgeUp",
        "title": "Envil: Nudge Number Up"
      },
      {
        "command": "envil.numberNudgeDown",
        "title": "Envil: Nudge Number Down"
      },
      {
        "command": "envil.numberNudgeUpFine",
        "title": "Envil: Nudge Number Up (fine)"
      },
      {
        "command": "envil.numberNudgeDownFine",
        "title": "Envil: Nudge Number Down (fine)"
      },
      {
        "command": "envil.runSCBlock",
        "title": "Envil: Run SC Block (CodeLens)"
      },
      {
        "command": "envil.runHydraBlock",
        "title": "Envil: Eval Hydra Block (CodeLens)"
      },
      {
        "command": "envil.peekToggle",
        "title": "Envil: Toggle Peek Overlay (Hydra)"
      },
      {
        "command": "envil.peekClear",
        "title": "Envil: Clear Peek Overlay (Hydra)"
      },
      {
        "command": "envil.touchKnobs.open",
        "title": "Envil: Open Touch Knobs",
        "icon": "$(record)"
      },
      {
        "command": "envil.touchKnobs.close",
        "title": "Envil: Close Touch Knobs"
      },
      {
        "command": "envil.energyMachine.open",
        "title": "Envil: Open Energy Machine",
        "icon": "$(zap)"
      },
      {
        "command": "envil.energyMachine.close",
        "title": "Envil: Close Energy Machine"
      },
      {
        "command": "envil.initWorkspace",
        "title": "Envil: Init Workspace",
        "icon": "$(folder-active)"
      },
      {
        "command": "envil.scBridge.watch",
        "title": "Envil: Watch SC Proxy → Hydra"
      },
      {
        "command": "envil.scBridge.unwatch",
        "title": "Envil: Unwatch SC Proxy"
      },
      {
        "command": "envil.scBridge.refresh",
        "title": "Envil: Refresh SC Proxy Bus Indices"
      },
      {
        "command": "envil.corpusSuggestor.reindex",
        "title": "Envil: Corpus – Rebuild Offline Index"
      },
      {
        "command": "envil.corpusSuggestor.showStats",
        "title": "Envil: Corpus – Show Index Stats"
      },
      {
        "command": "envil.corpusSuggestor.composeAtCursor",
        "title": "Envil: Corpus – Compose at Cursor (LLM)"
      },
      {
        "command": "envil.corpusSuggestor.triggerInline",
        "title": "Envil: Corpus – Trigger Inline Suggestion"
      },
      {
        "command": "envil.corpusSuggestor.revealCache",
        "title": "Envil: Corpus – Reveal Cache in File Manager"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "Envil",
        "properties": {
          "envil.environment.active": {
            "type": "boolean",
            "default": false,
            "description": "Whether the ENVIL environment is currently active."
          },
          "envil.touchKnobs.autoOpen": {
            "type": "boolean",
            "default": true,
            "description": "Automatically open the Touch Knobs panel on startup (centre column)."
          },
          "envil.energyMachine.autoOpen": {
            "type": "boolean",
            "default": true,
            "description": "Automatically open the Energy Machine panel on startup when the workspace has used it before (.envil/energy.json exists)."
          },
          "envil.sequencer.oscEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Send OSC messages from touch-knob sequencers on each tick."
          },
          "envil.sequencer.oscTargetPort": {
            "type": "integer",
            "default": 57120,
            "description": "UDP port to send sequencer OSC messages to (default: 57120 = sclang)."
          },
          "envil.sequencer.oscTargetHost": {
            "type": "string",
            "default": "127.0.0.1",
            "description": "Host address to send sequencer OSC messages to."
          },
          "envil.mediapipe.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable MediaPipe Holistic body tracking in the Touch Knobs panel (webcam required)."
          },
          "envil.mediapipe.sendRate": {
            "type": "integer",
            "default": 15,
            "minimum": 1,
            "maximum": 60,
            "description": "Max landmark updates per second sent to SuperCollider (lower = less CPU)."
          },
          "envil.mediapipe.modelComplexity": {
            "type": "integer",
            "default": 1,
            "minimum": 0,
            "maximum": 2,
            "enum": [0, 1, 2],
            "description": "MediaPipe model complexity: 0 = lite, 1 = full, 2 = heavy (more accurate but slower)."
          },
          "envil.mediapipe.videoOpacity": {
            "type": "number",
            "default": 0.25,
            "minimum": 0,
            "maximum": 1,
            "description": "Webcam background opacity (0 = invisible, 1 = fully visible)."
          },
          "envil.mediapipe.drawLandmarks": {
            "type": "boolean",
            "default": true,
            "description": "Draw detected landmarks as an overlay on the knob canvas."
          },
          "envil.dynbuf.numChannels": {
            "type": "integer",
            "default": 8,
            "minimum": 1,
            "maximum": 16,
            "description": "Number of channels recorded by the dynamic buffer system. Default layout (8): c0-c3 = hardware inputs 0-3, c4-c5 = main output buses (~out L/R), c6-c7 = free (re-point via Library.at(\\envil, \\setRecBus).value(idx, busIndex)). Channel selector on each row picks one of these."
          },
          "envil.dynbuf.ringSeconds": {
            "type": "number",
            "default": 32,
            "minimum": 1,
            "description": "Length (in seconds) of the always-running ring buffer that snapshots are taken from."
          },
          "envil.dynbuf.snapshotSeconds": {
            "type": "number",
            "default": 8,
            "minimum": 0.1,
            "description": "Default length (in seconds) of a captured snapshot buffer."
          },
          "envil.dynbuf.writeToDisk": {
            "type": "boolean",
            "default": true,
            "description": "When true, every snapshot is written to <workspace>/.envil/dynbufs/slot_N.wav (one file per slot, overwritten on each SNAP). Required for waveform display and session reload."
          }
        }
      },
      {
        "type": "object",
        "title": "SuperCollider",
        "properties": {
          "envil.supercollider.sclang.cmd": {
            "type": [
              "string",
              "null"
            ],
            "default": "/usr/bin/sclang",
            "description": "Path to the sclang executable."
          },
          "envil.supercollider.server.numInputBusChannels": {
            "type": "integer",
            "default": 4,
            "minimum": 0,
            "maximum": 128,
            "description": "Number of hardware input bus channels (s.options.numInputBusChannels) applied before every server boot/reboot started from the plugin."
          },
          "envil.supercollider.server.numOutputBusChannels": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 128,
            "description": "Number of hardware output bus channels (s.options.numOutputBusChannels) applied before every server boot/reboot started from the plugin."
          },
          "envil.supercollider.proxySpace.autoInit": {
            "type": "boolean",
            "default": true,
            "description": "After server boot: automatically push a ProxySpace and create ~out.ar(2).play."
          },
          "envil.supercollider.proxySpace.numInputs": {
            "type": "integer",
            "default": 2,
            "minimum": 0,
            "maximum": 16,
            "description": "Number of hardware audio inputs to pre-create as proxies on boot (~i0, ~i1, … with pitch detection ~f0, ~f1, … and amplitude ~a0, ~a1, …). Set to 0 to disable."
          },
          "envil.supercollider.proxySpace.pitchMethod": {
            "type": "string",
            "default": "Tartini",
            "enum": ["Tartini", "Pitch", "ZeroCrossing"],
            "description": "Pitch detection UGen for ~fN proxies. Tartini (sc3-plugins, best quality/perf tradeoff), Pitch (built-in, heavier), ZeroCrossing (lightest, rawer)."
          },
          "envil.supercollider.midi.autoProxies": {
            "type": "boolean",
            "default": true,
            "description": "Automatically expose incoming MIDI as NodeProxies (lazily, on first message): ~<pfx>_c<num> for CCs (0..1), ~<pfx>_n<num> for note velocities, ~<pfx>_n / ~<pfx>_n_val for last note. Prefix per device via midi.devicePrefixes."
          },
          "envil.supercollider.midi.devicePrefixes": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "default": {
              "midiin3 (akai mpd24)": "b",
              "akai mpd24 midi 3": "b",
              "akai mpd24": "a",
              "teensy midi": "f",
              "triggerio": "t",
              "launch control xl": "l",
              "uac-8": "b",
              "fast track ultra": "b",
              "umc404hd": "b",
              "digital jockey": "j",
              "umx 61": "u",
              "arduino leonardo": "al",
              "seaboard": "sea",
              "midi function": "jam",
              "midi gadget": "jam"
            },
            "description": "MIDI device name (case-insensitive substring, first match wins — put more specific entries first) → proxy prefix. E.g. \"teensy midi\": \"f\" makes CC 49 appear as ~f_c49."
          },
          "envil.supercollider.midi.defaultPrefix": {
            "type": "string",
            "default": "m",
            "description": "Proxy prefix for MIDI devices not matched in midi.devicePrefixes (all unmatched devices share it)."
          },
          "envil.supercollider.midi.watchdogSeconds": {
            "type": "integer",
            "default": 60,
            "minimum": 0,
            "maximum": 3600,
            "description": "MIDI watchdog interval in seconds: periodically reconnects all MIDI sources (hot-plug resilience, like e[\\startMidiWatchdog] in the old rig) and posts a check line to the console. 0 disables the watchdog."
          },
          "envil.supercollider.synthDefs.autoLoad": {
            "type": "boolean",
            "default": true,
            "description": "Load default SynthDefs from ~/.config/envil/synthdefs/*.scd (global) and <workspace>/.envil/synthdefs/*.scd (overlays global on same filename) on every server boot. Re-sent automatically after reboots; edit files and run 'Envil: Reload Default SynthDefs' to apply live."
          },
          "envil.supercollider.sclang.sclang_conf": {
            "type": [
              "string",
              "null"
            ],
            "default": "~/.config/SuperCollider/sclang_conf.yaml",
            "description": "Path to the sclang_conf.yaml file."
          }
        }
      },
      {
        "type": "object",
        "title": "Envil – Offline Suggestions",
        "properties": {
          "envil.corpusSuggestor.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Experimental — master switch for the offline suggestion system (corpus indexing + dropdown + inline + LLM compose). Off by default while the feature is WIP. See README § Experimental features."
          },
          "envil.corpusSuggestor.indexOnStartup": {
            "type": "boolean",
            "default": true,
            "description": "Build the corpus index automatically when the extension activates if none is cached."
          },
          "envil.corpusSuggestor.sources": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Extra directories (absolute paths, ~ expanded) to scan for .sc/.scd files. Workspace folders are always included."
          },
          "envil.corpusSuggestor.includeSCHelp": {
            "type": "boolean",
            "default": true,
            "description": "Also index example blocks from the local SuperCollider help / class library."
          },
          "envil.corpusSuggestor.scHelpPath": {
            "type": "string",
            "default": "",
            "description": "Override path for the SuperCollider HelpSource / SCClassLibrary directory. Empty = auto-detect."
          },
          "envil.corpusSuggestor.includeHiddenJamsDirs": {
            "type": "boolean",
            "default": true,
            "description": "Include directories starting with 'zz_' (used for daily / inspiration folders)."
          },
          "envil.corpusSuggestor.dropdown.maxItems": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 30,
            "description": "Max items shown in the '_TPL_' / '//?' dropdown."
          },
          "envil.corpusSuggestor.inline.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Experimental. Enable ghost-text inline suggestions from the local corpus (cycle with Alt+] / Alt+[). Note: GitHub Copilot, if installed, wins the primary ghost-text slot — disable Copilot for SuperCollider files to give Envil priority."
          },
          "envil.corpusSuggestor.inline.maxItems": {
            "type": "integer",
            "default": 3,
            "minimum": 1,
            "maximum": 10,
            "description": "Max inline suggestion variants."
          },
          "envil.corpusSuggestor.llm.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Experimental. Enable local LLM (Ollama) for 'Compose at Cursor' with fill-in-the-middle. Requires a running Ollama server — see README § Experimental features."
          },
          "envil.corpusSuggestor.llm.endpoint": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Ollama endpoint URL."
          },
          "envil.corpusSuggestor.llm.model": {
            "type": "string",
            "default": "qwen2.5-coder:3b-base",
            "description": "Ollama model name. Recommended FIM models: qwen2.5-coder:1.5b-base, qwen2.5-coder:3b-base, qwen2.5-coder:7b-base, deepseek-coder:1.3b-base."
          },
          "envil.corpusSuggestor.llm.useRAG": {
            "type": "boolean",
            "default": true,
            "description": "Retrieve top-k blocks from the local corpus and inject them as reference context before calling the LLM."
          },
          "envil.corpusSuggestor.llm.temperature": {
            "type": "number",
            "default": 0.2,
            "minimum": 0,
            "maximum": 2,
            "description": "Sampling temperature for the LLM."
          },
          "envil.corpusSuggestor.llm.numPredict": {
            "type": "integer",
            "default": 256,
            "minimum": 16,
            "maximum": 2048,
            "description": "Max tokens to generate per compose call."
          },
          "envil.corpusSuggestor.llm.contextChars": {
            "type": "integer",
            "default": 4000,
            "minimum": 200,
            "maximum": 20000,
            "description": "Max chars of prefix / suffix fed to the LLM."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[supercollider]": {
        "editor.wordSeparators": "`!@#$%^&*()-=+[{]}\\|;:'\",.<>/?"
      },
      "[javascript]": {
        "editor.suggest.showMethods": false,
        "editor.suggest.showFunctions": false,
        "editor.suggest.showConstructors": false,
        "editor.suggest.showFields": false,
        "editor.suggest.showVariables": false,
        "editor.suggest.showClasses": false,
        "editor.suggest.showStructs": false,
        "editor.suggest.showInterfaces": false,
        "editor.suggest.showModules": false,
        "editor.suggest.showProperties": false,
        "editor.suggest.showEvents": false,
        "editor.suggest.showOperators": false,
        "editor.suggest.showUnits": false,
        "editor.suggest.showValues": false,
        "editor.suggest.showConstants": false,
        "editor.suggest.showEnums": false,
        "editor.suggest.showEnumMembers": false,
        "editor.suggest.showKeywords": false,
        "editor.suggest.showWords": false,
        "editor.suggest.showColors": false,
        "editor.suggest.showFiles": false,
        "editor.suggest.showReferences": false,
        "editor.suggest.showFolders": false,
        "editor.suggest.showTypeParameters": false,
        "editor.suggest.showSnippets": false,
        "editor.suggest.showIssues": false,
        "editor.suggest.showUsers": true
      }
    },
    "keybindings": [
      {
        "command": "envil.supercollider.executeBlock",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.supercollider.executeBlock",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.hydra.evaluate",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == 'javascript' && config.envil.environment.active"
      },
      {
        "command": "envil.supercollider.hush",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "editorTextFocus"
      },
      {
        "command": "envil.supercollider.openHelpFor",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.supercollider.search",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.supercollider.selectBracketBlock",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.numberNudgeUp",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up",
        "when": "editorTextFocus && config.envil.environment.active"
      },
      {
        "command": "envil.numberNudgeDown",
        "key": "ctrl+shift+down",
        "mac": "cmd+shift+down",
        "when": "editorTextFocus && config.envil.environment.active"
      },
      {
        "command": "envil.numberNudgeUpFine",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "editorTextFocus && config.envil.environment.active"
      },
      {
        "command": "envil.numberNudgeDownFine",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "editorTextFocus && config.envil.environment.active"
      },
      {
        "command": "envil.peekToggle",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus && editorLangId == 'javascript' && config.envil.environment.active"
      },
      {
        "command": "envil.touchKnobs.open",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "config.envil.environment.active"
      },
      {
        "command": "envil.corpusSuggestor.composeAtCursor",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      },
      {
        "command": "envil.corpusSuggestor.triggerInline",
        "key": "alt+/",
        "when": "editorTextFocus && editorLangId == 'supercollider'"
      }
    ]
  },
  "extensionDependencies": [
    "subframe7536.custom-ui-style"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "cd client && npm install && tsc -p . && cd ../server && npm install && tsc -p .",
    "watch": "tsc -b client server -w",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.86.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonc-parser": "^3.2.1",
    "osc": "^2.4.4",
    "socket.io": "^4.7.4"
  }
}